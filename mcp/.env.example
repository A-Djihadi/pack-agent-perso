# Copie ce fichier en ".env" (qui est ignoré par git) et remplis les valeurs.
# Ne commite JAMAIS le fichier .env.
# Ces variables doivent être présentes dans l'environnement du terminal
# qui lance ton outil d'agent (ex. Claude Code) pour que ${...} soit remplacé.

# --- X / Twitter (serveur MCP officiel d'X via le pont xurl) ---
# Récupérés dans le portail développeur X : https://developer.x.com
X_CLIENT_ID=[ton-client-id-x]
X_CLIENT_SECRET=[ton-client-secret-x]

# --- Instagram (dépend du serveur MCP choisi : noms de variables à vérifier) ---
INSTAGRAM_ACCESS_TOKEN=[ton-token-instagram]
INSTAGRAM_ACCOUNT_ID=[id-de-ton-compte-instagram-pro]
